<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ product.name }} - ProductShop</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<nav class="navbar">
  <div class="nav-container">
    <a href="{{ url_for('index') }}" class="nav-brand">&#9881; ProductShop</a>
    <ul class="nav-links">
      <li><a href="{{ url_for('index') }}">Products</a></li>
      <li><a href="{{ url_for('add_product') }}">Add Product</a></li>
      <li><a href="/compiler/validate">Compiler Validation</a></li>
    </ul>
  </div>
</nav>

<main class="main-content">
  <nav class="breadcrumb">
    <a href="{{ url_for('index') }}">Products</a>
    <span class="breadcrumb-sep">/</span>
    <span>{{ product.name }}</span>
  </nav>

  <div class="detail-card">
    <div class="detail-card__image-col">
      <img src="{{ product.image }}" alt="{{ product.name }}" class="detail-card__image">
    </div>
    <div class="detail-card__info-col">
      <span class="badge">{{ product.category }}</span>
      <h1 class="detail-card__name">{{ product.name }}</h1>
      <p class="detail-card__price">${{ "%.2f"|format(product.price) }}</p>
      {% if product.price >= 500 %}
      <p class="notice notice--premium">Premium product: free shipping included.</p>
      {% elif product.price >= 100 %}
      <p class="notice">Standard shipping applies.</p>
      {% else %}
      <p class="notice notice--budget">Budget pick: great value.</p>
      {% endif %}

      <hr class="divider">
      <h2 class="detail-section-title">Description</h2>
      <p class="detail-card__details">{{ product.details }}</p>
      <hr class="divider">

      <div class="detail-meta">
        <span class="meta-label">Product ID:</span>
        <code class="meta-value">{{ product.id }}</code>
      </div>

      <div class="detail-actions">
        <a href="{{ url_for('index') }}" class="btn btn--outline">&#8592; Back to Products</a>
        <a href="{{ url_for('edit_product', product_id=product.id) }}" class="btn btn--secondary">Edit</a>
        <form action="{{ url_for('delete_product', product_id=product.id) }}" method="POST" class="inline-form" data-confirm="Delete {{ product.name }}?">
          <button type="submit" class="btn btn--danger">Delete Product</button>
        </form>
      </div>
    </div>
  </div>
</main>

<footer class="footer">
  <p>Compilers 2 project &mdash; pages generated by the Java Flask/Jinja compiler from app.py + templates/*.jinja</p>
</footer>
<script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
