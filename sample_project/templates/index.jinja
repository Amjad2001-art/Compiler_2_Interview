<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products - ProductShop</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<nav class="navbar">
  <div class="nav-container">
    <a href="{{ url_for('index') }}" class="nav-brand">&#9881; ProductShop</a>
    <ul class="nav-links">
      <li><a href="{{ url_for('index') }}" class="active">Products</a></li>
      <li><a href="{{ url_for('add_product') }}">Add Product</a></li>
      <li><a href="/compiler/trees">Compiler Trees</a></li>
      <li><a href="/compiler/validate">Compiler Validation</a></li>
    </ul>
  </div>
</nav>

<main class="main-content">
  <div class="page-header">
    <div>
      <h1 class="page-title">Product Catalog</h1>
      <p class="page-subtitle">{{ products|length }} product(s) in {{ categories|length }} categories</p>
    </div>
    <a href="{{ url_for('add_product') }}" class="btn btn--primary">+ Add Product</a>
  </div>

  <div class="category-bar" role="group" aria-label="Filter products by category">
    <button type="button" class="chip chip--active" data-category-filter="all" aria-pressed="true">All Products</button>
    {% for category in categories %}
    <button type="button" class="chip" data-category-filter="{{ category }}" aria-pressed="false">{{ category }}</button>
    {% endfor %}
  </div>
  <p class="category-filter-feedback" id="category-filter-feedback" role="status" aria-live="polite" hidden></p>

  {% if products %}
  <div class="product-grid" id="product-grid">
    {% for product in products %}
    <article class="product-card" data-product-id="{{ product.id }}" data-category="{{ product.category }}">
      <div class="product-card__image-wrap">
        <img src="{{ product.image }}" alt="{{ product.name }}" class="product-card__image">
      </div>
      <div class="product-card__body">
        <span class="badge">{{ product.category }}</span>
        <h2 class="product-card__name">{{ product.name }}</h2>
        <p class="product-card__price">${{ "%.2f"|format(product.price) }}</p>
        <p class="product-card__details">{{ product.details|truncate(90) }}</p>
      </div>
      <div class="product-card__actions">
        <a href="{{ url_for('product_detail', product_id=product.id) }}" class="btn btn--outline">Details</a>
        <a href="{{ url_for('edit_product', product_id=product.id) }}" class="btn btn--secondary">Edit</a>
        <a href="{{ url_for('delete_product', product_id=product.id) }}" class="btn btn--danger">Delete</a>
      </div>
    </article>
    {% endfor %}
  </div>
  <div class="category-filter-empty" id="category-filter-empty" hidden>
    <h2>No products in this category</h2>
    <p>Choose another category or select All Products to see the complete catalog.</p>
  </div>
  {% else %}
  <div class="empty-state">
    <h2>No products yet</h2>
    <p>Add your first product to get started.</p>
    <a href="{{ url_for('add_product') }}" class="btn btn--primary">Add First Product</a>
  </div>
  {% endif %}
</main>

<footer class="footer">
  <p>Compilers 2 project &mdash; pages generated by the Java Flask/Jinja compiler from app.py + templates/*.jinja</p>
</footer>
<script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
