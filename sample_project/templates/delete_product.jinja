<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delete {{ product.name }} - ProductShop</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<nav class="navbar">
  <div class="nav-container">
    <a href="{{ url_for('index') }}" class="nav-brand">&#9881; ProductShop</a>
    <ul class="nav-links">
      <li><a href="{{ url_for('index') }}">Products</a></li>
      <li><a href="{{ url_for('add_product') }}">Add Product</a></li>
      <li><a href="/compiler/validate">Compiler Validation</a></li>
    </ul>
  </div>
</nav>

<main class="main-content">
  <div class="form-page">
    <div class="form-card form-card--danger">
      <div class="form-card__header">
        <h1>Delete Product</h1>
        <p>This action removes the product from the catalog and regenerates the site.</p>
      </div>

      <div class="confirm-box">
        <img src="{{ product.image }}" alt="{{ product.name }}" class="confirm-box__image">
        <div>
          <span class="badge">{{ product.category }}</span>
          <h2 class="confirm-box__name">{{ product.name }}</h2>
          <p class="product-card__price">${{ "%.2f"|format(product.price) }}</p>
          <p class="confirm-box__question">Are you sure you want to delete <strong>{{ product.name }}</strong> (ID {{ product.id }})?</p>
        </div>
      </div>

      <form action="{{ url_for('delete_product', product_id=product.id) }}" method="POST" class="product-form" data-confirm="Really delete {{ product.name }}?">
        <div class="form-actions">
          <a href="{{ url_for('product_detail', product_id=product.id) }}" class="btn btn--outline">Cancel</a>
          <a href="{{ url_for('index') }}" class="btn btn--outline">Back to Products</a>
          <button type="submit" class="btn btn--danger">Yes, delete it</button>
        </div>
      </form>
    </div>
  </div>
</main>

<footer class="footer">
  <p>Compilers 2 project &mdash; pages generated by the Java Flask/Jinja compiler from app.py + templates/*.jinja</p>
</footer>
<script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
