<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product - ProductShop</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<nav class="navbar">
  <div class="nav-container">
    <a href="{{ url_for('index') }}" class="nav-brand">&#9881; ProductShop</a>
    <ul class="nav-links">
      <li><a href="{{ url_for('index') }}">Products</a></li>
      <li><a href="{{ url_for('add_product') }}" class="active">Add Product</a></li>
      <li><a href="/compiler/validate">Compiler Validation</a></li>
    </ul>
  </div>
</nav>

<main class="main-content">
  <div class="form-page">
    <div class="form-card">
      <div class="form-card__header">
        <h1>Add New Product</h1>
        <p>Fill in the fields below to add a product to the catalog. Saving regenerates the site.</p>
      </div>

      <form action="{{ url_for('add_product') }}" method="POST" class="product-form" novalidate>
        <div class="form-group">
          <label for="name" class="form-label">Product Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Wireless Headphones" maxlength="200" required>
        </div>

        <div class="form-group">
          <label for="price" class="form-label">Price (USD) <span class="required">*</span></label>
          <div class="input-with-prefix">
            <span class="input-prefix">$</span>
            <input type="number" id="price" name="price" class="form-input" placeholder="0.00" min="0" step="0.01" required>
          </div>
        </div>

        <div class="form-group">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="category" class="form-input">
            {% for category in categories %}
            <option value="{{ category }}">{{ category }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="form-group">
          <label for="details" class="form-label">Details <span class="required">*</span></label>
          <textarea id="details" name="details" class="form-input form-textarea" placeholder="Describe the product..." maxlength="2000" rows="4" required></textarea>
        </div>

        <div class="form-group">
          <label for="image" class="form-label">Image URL <span class="optional">(optional)</span></label>
          <input type="url" id="image" name="image" class="form-input" placeholder="https://example.com/image.jpg">
          <small class="form-hint">Leave blank to use a placeholder image.</small>
        </div>

        <div class="form-group" id="preview-group" hidden>
          <span class="form-label">Image Preview</span>
          <img id="image-preview" src="" alt="Image preview" class="image-preview">
        </div>

        <div class="form-actions">
          <a href="{{ url_for('index') }}" class="btn btn--outline">Cancel</a>
          <button type="submit" class="btn btn--primary">Add Product</button>
        </div>
      </form>
    </div>
  </div>
</main>

<footer class="footer">
  <p>Compilers 2 project &mdash; pages generated by the Java Flask/Jinja compiler from app.py + templates/*.jinja</p>
</footer>
<script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
